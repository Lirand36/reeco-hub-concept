# Copy to .env. Any system left empty runs in MOCK mode: the request is built exactly
# as it would be sent, logged in the Integration log, and answered with a fake response.

PORT=3000
PUBLIC_URL=http://localhost:3000     # used for "Open in Reeco Hub" links in Slack

# HubSpot: Private App token (scopes: crm.objects.deals.write, crm.objects.companies.read, crm.objects.notes.write)
HUBSPOT_TOKEN=

# Intercom: access token, the admin replies are sent as, and client secret for webhook signatures
INTERCOM_TOKEN=
INTERCOM_ADMIN_ID=
INTERCOM_CLIENT_SECRET=

# Jira Cloud: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=                       # e.g. https://reeco.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SUPPORT_PROJECT=SUP
JIRA_ONBOARDING_PROJECT=ONB

# Slack: bot token (chat:write, channels:manage) + signing secret for the Interactivity URL
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_DEALS=                 # channel IDs, e.g. C0123456789
SLACK_CHANNEL_SUPPORT=
SLACK_CHANNEL_DEAL_DESK=
SLACK_APPROVER_IDS=                  # Slack user IDs allowed to approve discounts, comma-separated
SLACK_DM_USER_ID=                    # demo: every DM (to Maya, Dana, the SEs…) goes to this member ID instead, labelled

# Snowflake SQL API
SNOWFLAKE_ACCOUNT=                   # e.g. myorg-myaccount
SNOWFLAKE_TOKEN=                     # programmatic access token (or key-pair JWT)
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_WAREHOUSE=GTM_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_ROLE=GTM_HUB

# Claude (Anthropic API) for AI assist in the inbox. Without a key, a rules-based mock runs instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
INTERCOM_TAG_IDS=                    # JSON map of close reason → Intercom tag id, e.g. {"bug_fixed":"7351002"}

# --- Google Calendar & Meet (meeting invites with Meet links) ---
# OAuth client (Google Cloud Console → Credentials → OAuth client ID → Web application).
# Redirect URI: <PUBLIC_URL>/oauth/google/callback. Then Connections → "Connect Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=                # shown once after "Connect Google"; paste it here so it survives restarts
# Safety: in live mode Google emails ONLY this address. Customers and team are listed inside the invite instead.
# Leave empty and no invite emails are sent at all.
GOOGLE_INVITE_EMAIL=
